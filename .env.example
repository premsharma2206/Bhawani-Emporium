# Copy to .env and fill in. Never commit .env.

# PostgreSQL. This default matches docker-compose.yml.
DATABASE_URL="postgresql://bhawani:bhawani@localhost:54329/bhawani?schema=public"

# Signs login sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Public URL of the site, used in emails.
APP_URL="http://localhost:3000"

# First admin account, created by `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Email (optional). Without SMTP_HOST, emails are printed to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Bhawani Emporium <orders@example.com>"
# Receives a copy of every order.
SHOP_EMAIL=""

# Product images (optional). Without CLOUDINARY_URL, uploads are stored in UPLOAD_DIR.
CLOUDINARY_URL=""
UPLOAD_DIR=".uploads"

# Online payments (optional). Without these, checkout offers pay on delivery only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
